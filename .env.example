# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# Phase 4 — AI analysis
#
# Provider selection. "openai" (default) calls the real provider and requires
# OPENAI_API_KEY. "mock" uses the deterministic local provider (no key needed,
# used by the E2E suite and db:verify-ai).
AI_PROVIDER=mock
#
# Required only when AI_PROVIDER=openai. Never expose this to the browser.
# OPENAI_API_KEY=sk-***
# Optional: override the API base URL (e.g. a gateway/proxy).
# OPENAI_BASE_URL=
# Optional: model name (default: gpt-4o-mini).
# AI_MODEL=gpt-4o-mini
#
# Mock provider behavior for tests only:
#   normal          - deterministic safe output (E2E phase 4)
#   error           - provider throws (E2E phase 4-failure)
#   invalid-output  - non-conforming structured output
#   unsafe-output   - draft asserts a prohibited commitment (safety gate rejects)
#   ambiguous-output- draft contains an ambiguous prohibited mention (manual review)
# AI_MOCK_BEHAVIOR=normal
#
# Phase 5A — real-provider validation (scripts/phase5a, pnpm db:phase5a-real)
#
# OpenAI gpt-4o-mini list prices in USD per 1M tokens (verified 2026-08-02).
# Override only if the account/custom-branch price differs; the report records
# the values used.
# PHASE5A_INPUT_PRICE_PER_1M=0.15
# PHASE5A_OUTPUT_PRICE_PER_1M=0.6